{
  "name": {
    "en": "Abra Linkbox+"
  },
  "class": "other",
  "capabilities": [
    "valve_open",
    "alarm_water",
    "onoff",
    "alarm_tamper",
    "alarm_generic",
    "valve_alarm_state",
    "cable_disconnected",
    "open_valve",
    "close_valve",
    "clear_leak_alarm"
  ],
  "capabilitiesOptions": {
    "valve_open": {
      "title": {
        "en": "Main water valve"
      },
      "titleTrue": {
        "en": "Open"
      },
      "titleFalse": {
        "en": "Closed"
      },
      "preventInsights": true,
      "preventTag": true
    },
    "alarm_water": {
      "title": {
        "en": "Water leak (any sensor)"
      },
      "insights": true
    },
    "onoff": {
      "title": {
        "en": "Main water valve"
      },
      "insights": true,
      "insightsTitleTrue": {
        "en": "Valve opened"
      },
      "insightsTitleFalse": {
        "en": "Valve closed"
      },
      "uiComponent": null
    },
    "alarm_tamper": {
      "title": {
        "en": "Tamper"
      }
    },
    "alarm_generic": {
      "title": {
        "en": "Valve fault"
      }
    },
    "open_valve": {
      "title": {
        "en": "Open main valve"
      },
      "desc": {
        "en": "Manually open the main shut-off valve."
      },
      "maintenanceAction": true
    },
    "close_valve": {
      "title": {
        "en": "Close main valve"
      },
      "desc": {
        "en": "Manually close the main shut-off valve. This stops all water to the property."
      },
      "maintenanceAction": true
    },
    "clear_leak_alarm": {
      "title": {
        "en": "Reset leak alarm"
      },
      "maintenanceAction": true
    }
  },
  "platforms": [
    "local"
  ],
  "images": {
    "small": "/drivers/linkbox/assets/images/small.png",
    "large": "/drivers/linkbox/assets/images/large.png",
    "xlarge": "/drivers/linkbox/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "start"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "manual"
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection"
      },
      "children": [
        {
          "id": "ip",
          "type": "text",
          "label": {
            "en": "IP address"
          },
          "hint": {
            "en": "The Linkbox+ IP address. Edit this to re-point the app without re-pairing."
          },
          "value": ""
        },
        {
          "id": "bacnetPort",
          "type": "number",
          "label": {
            "en": "BACnet/IP port"
          },
          "value": 47808,
          "min": 1,
          "max": 65535
        },
        {
          "id": "deviceInstance",
          "type": "label",
          "label": {
            "en": "BACnet device instance"
          },
          "value": "-"
        },
        {
          "id": "model",
          "type": "label",
          "label": {
            "en": "Model"
          },
          "value": "-"
        },
        {
          "id": "serial",
          "type": "label",
          "label": {
            "en": "Serial"
          },
          "value": "-"
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Valve control"
      },
      "children": [
        {
          "id": "valve_write_priority",
          "type": "number",
          "label": {
            "en": "BACnet write priority"
          },
          "hint": {
            "en": "Command priority (1 = highest, 16 = lowest) used when opening/closing the valve."
          },
          "value": 8,
          "min": 1,
          "max": 16
        }
      ]
    }
  ]
}
