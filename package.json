{
  "name": "org.barelysufficient.waterguard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "volta": {
    "node": "22.23.4",
    "npm": "10.9.4"
  },
  "main": "app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/check-test-titles.js && eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "arch:check": "dependency-cruiser --config .dependency-cruiser.cjs app.ts lib drivers",
    "test": "npm run typecheck && vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "validate": "npm run lint && npm run arch:check && npm test && homey app validate --level publish",
    "fake-linkbox": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fake-linkbox.ts",
    "start": "homey app run --remote",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,mts,cts}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "**/*.{js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  },
  "dependencies": {
    "bacstack": "0.0.1-beta.14",
    "pino": "^10.4.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^1.8.3",
    "@types/node": "^22.20.5",
    "@types/source-map-support": "^0.5.10",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
